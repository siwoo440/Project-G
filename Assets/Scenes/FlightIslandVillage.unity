  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProjectG.FlightVillageNpc
  speaker: "\uCD9C\uACA9 \uC548\uB0B4\uC6D0"
  dialogue:
  - text: "\uCD9C\uACA9 \uC804\uC5D0 \uC870\uC885\uC0AC\uC640 \uC7A5\uBE44\uB97C
      \uD655\uC778\uD558\uACE0 \uAC08\uAE4C\uC694?"
    next: 1
    choices: []
  - text: "\uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
    next: -1
    choices:
    - label: "\uCD9C\uACA9 \uC900\uBE44 \uC5F4\uAE30"
      next: -1
      service: 4
    - label: "\uC774\uC6A9 \uBC29\uBC95 \uBB3B\uAE30"
      next: 2
      service: 0
    - label: "\uB2E4\uC74C\uC5D0 \uC62C\uAC8C\uC694"
      next: -1
      service: 1
  - text: "\uCD9C\uACA9 \uC900\uBE44\uC5D0\uC11C \uC870\uC885\uC0AC\uC640 \uBE57\uC790\uB8E8,
      \uC67C\uCABD\uACFC \uC624\uB978\uCABD \uB9C8\uBC95\uC744 \uD655\uC778\uD560
      \uC218 \uC788\uC5B4\uC694."
    next: 1
    choices: []
  body: {fileID: 2024869396}
  focus: {fileID: 438557645}
  radius: 3.45
