  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProjectG.FlightVillageNpc
  speaker: "\uACF5\uBC29 \uB2F4\uB2F9\uC790"
  dialogue:
  - text: "\uC5B4\uC11C \uC624\uC138\uC694. \uC7A5\uCC29\uD55C \uBD80\uD488\uC744
      \uC190\uBCF4\uACE0 \uAC08\uAE4C\uC694?"
    next: 1
    choices: []
  - text: "\uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
    next: -1
    choices:
    - label: "\uAC15\uD654 \uACF5\uBC29 \uC5F4\uAE30"
      next: -1
      service: 3
    - label: "\uC774\uC6A9 \uBC29\uBC95 \uBB3B\uAE30"
      next: 2
      service: 0
    - label: "\uB2E4\uC74C\uC5D0 \uC62C\uAC8C\uC694"
      next: -1
      service: 1
  - text: "\uAC15\uD654\uD560 \uBD80\uC704\uB97C \uACE0\uB974\uACE0 \uD544\uC694\uD55C
      \uCC9C\uACF5 \uACB0\uC815\uACFC \uACE8\uB4DC\uB97C \uD655\uC778\uD574 \uC8FC\uC138\uC694."
    next: 1
    choices: []
