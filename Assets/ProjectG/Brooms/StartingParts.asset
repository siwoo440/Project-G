  sets:
  - id: storm
    displayName: "\ud3ed\ud48d\uc758 \uc9c8\uc8fc \uc138\ud2b8"
    effectTwo: "\ucd5c\ub300 \uc77c\ubc18 \ube44\ud589 \uc18d\ub3c4 +1 m/s."
    effectFour: "\uac00\uc18d\ub825 \ubc0f \uc81c\ub3d9\ub825 \uac01\uac01 +4 m/s\u00b2."
    effectEight: "\ub300\uc2dc \uc885\ub8cc \uc2dc \uc804\ubc29\uc73c\ub85c \ubc14\ub78c \ud0c4\ud658 3\ubc1c\uc744 \ubc1c\uc0ac\ud569\ub2c8\ub2e4.\n\uac01 \uae30\ubcf8 \ud53c\ud574 8, \ub0b4\ubd80 \ucfe8\ud0c0\uc784 3\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 30\ud68c."
  - id: guard
    displayName: "\ucc9c\uacf5\uc758 \uc218\ud638 \uc138\ud2b8"
    effectTwo: "\ucda9\uaca9 \uc800\ud56d +5%p."
    effectFour: "\ud53c\uaca9 \ud6c4 5\ucd08 \ub3d9\uc548 \ubcf4\ud638\ub9c9 10\uc744 \uc0dd\uc131\ud569\ub2c8\ub2e4.\n\ub0b4\ubd80 \ucfe8\ud0c0\uc784 8\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 20\ud68c."
    effectEight: "\ubcf4\ud638\ub9c9\uc774 \ud53c\ud574\ub85c \ud30c\uad34\ub418\uba74 \ubc18\uacbd 2m \ub0b4 \uc18c\uac70 \uac00\ub2a5\ud55c \uc801\ud0c4\uc744 \ucd5c\ub300 5\ubc1c \uc81c\uac70\ud569\ub2c8\ub2e4.\n\ub0b4\ubd80 \ucfe8\ud0c0\uc784 10\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 12\ud68c."
  - id: flow
    displayName: "\ub9c8\ub825\uc758 \uc21c\ud658 \uc138\ud2b8"
    effectTwo: "\ucd5c\ub300 \ub9c8\ub825 +10."
    effectFour: "\ucd08\ub2f9 \ub9c8\ub825 \ud68c\ubcf5\ub7c9 +2."
    effectEight: "\ub9c8\ub825\uc774 30 \uc774\ud558\uac00 \ub418\ub294 \uacbd\uc6b0 \ub9c8\ub825 20\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.\n\ub0b4\ubd80 \ucfe8\ud0c0\uc784 20\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 8\ud68c."
  - id: starlight
    displayName: "\ubcc4\ube5b\uc758 \uc870\uc728 \uc138\ud2b8"
    effectTwo: "\ub9c8\ubc95 \uacf5\uaca9\ub825 +8."
    effectFour: "\ub9c8\ubc95 \uacf5\uaca9\ub825 +12 \ucd94\uac00."
    effectEight: "\uc81c\uc791 \ub9c8\ubc95 \ucd5c\ucd08 \uba85\uc911 \uc2dc \ubcc4\ube5b \ud0c4\ud658 2\ubc1c\uc744 \ucd94\uac00 \ubc1c\uc0ac\ud569\ub2c8\ub2e4.\n\uac01 \uae30\ubcf8 \ud53c\ud574 8, \ub0b4\ubd80 \ucfe8\ud0c0\uc784 6\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 30\ud68c."
  - id: hawk
    displayName: "\ub9e4\uc758 \uc2dc\uc120 \uc138\ud2b8"
    effectTwo: "\ub9c8\ubc95 \uc0ac\uac70\ub9ac +10%p."
    effectFour: "\ud0c4\ud658 \uc18d\ub3c4 +15%p."
    effectEight: "20m \uc774\uc0c1 \ub5a8\uc5b4\uc9c4 \ub300\uc0c1\uc5d0 \ucd5c\ucd08 \uba85\uc911\ud558\uba74 \ucd94\uac00 \uae30\ubcf8 \ud53c\ud574 12\ub97c \uc90d\ub2c8\ub2e4.\n\ub0b4\ubd80 \ucfe8\ud0c0\uc784 4\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 45\ud68c."
  - id: shadow
    displayName: "\uadf8\ub9bc\uc790\uc758 \ube44\ud589 \uc138\ud2b8"
    effectTwo: "\uc120\ud68c \uc18d\ub3c4 +30\u00b0/\ucd08."
    effectFour: "\uadf8\ub808\uc774\uc988 \uc131\uacf5 \uc2dc \ub9c8\ub825 2 \ud68c\ubcf5.\n\ub0b4\ubd80 \ucfe8\ud0c0\uc784 1\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 60\ud68c."
    effectEight: "\uadf8\ub808\uc774\uc988 5\ud68c \ub2ec\uc131 \uc2dc \ubc18\uaca9\ud0c4 2\ubc1c \ubc1c\uc0ac.\n\uac01 \uae30\ubcf8 \ud53c\ud574 8, \ub0b4\ubd80 \ucfe8\ud0c0\uc784 4\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 30\ud68c.\n\ubc1c\ub3d9 \uc2dc \ud69f\uc218 \ucd08\uae30\ud654."
  - id: flame
    displayName: "\ud654\uc5fc\uc758 \uada4\uc801 \uc138\ud2b8"
    effectTwo: "\ud654\uc5fc \ub9c8\ubc95 \ud0c4\ud658 \uc18d\ub3c4 +5%p."
    effectFour: "\ub300\uc2dc \ud6c4 2\ucd08\uac04 \ud654\uc5fc \uada4\uc801\uc744 \uc0dd\uc131\ud569\ub2c8\ub2e4.\n\uc801\ub2f9 \uae30\ubcf8 \ud53c\ud574 6\uc744 1\ud68c \uc801\uc6a9\ud558\uba70 \ub0b4\ubd80 \ucfe8\ud0c0\uc784 5\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 25\ud68c."
    effectEight: "\ud654\uc5fc \ub9c8\ubc95 \ucd5c\ucd08 \uba85\uc911 \uc9c0\uc810 \ubc18\uacbd 2.5m\uc5d0 \uae30\ubcf8 \ud53c\ud574 18\uc758 \ud3ed\ubc1c\uc744 \uc0dd\uc131\ud569\ub2c8\ub2e4.\n\ub0b4\ubd80 \ucfe8\ud0c0\uc784 8\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 20\ud68c."
  - id: frost
    displayName: "\uc11c\ub9ac\uc758 \uc7a5\ubcbd \uc138\ud2b8"
    effectTwo: "\ub0c9\uae30 \ub9c8\ubc95 \uc0ac\uac70\ub9ac +10%p."
    effectFour: "\ub0c9\uae30 \ub9c8\ubc95 \ucd5c\ucd08 \uba85\uc911 \ub300\uc0c1\uc758 \uc774\ub3d9 \uc18d\ub3c4\ub97c 2\ucd08 \ub3d9\uc548 10%p \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4.\n\ub0b4\ubd80 \ucfe8\ud0c0\uc784 4\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 30\ud68c."
    effectEight: "\ud53c\uaca9 \uc2dc \ubc18\uacbd 3m \ub0b4 \uc18c\uac70 \uac00\ub2a5\ud55c \uc801\ud0c4\uc744 \ucd5c\ub300 5\ubc1c \uc81c\uac70\ud569\ub2c8\ub2e4.\n\ub0b4\ubd80 \ucfe8\ud0c0\uc784 12\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 10\ud68c."
  - id: thunder
    displayName: "\ubc88\uac1c\uc758 \uacf5\uba85 \uc138\ud2b8"
    effectTwo: "\ubc88\uac1c \ub9c8\ubc95 \ud0c4\ud658 \uc18d\ub3c4 +10%p."
    effectFour: "\ubc88\uac1c \ub9c8\ubc95 \ucd5c\ucd08 \uba85\uc911 \uc2dc \uc778\uc811 \uc801\uc5d0\uac8c \uae30\ubcf8 \ud53c\ud574 8\uc758 \uc5f0\uc1c4 \uacf5\uaca9 1\ud68c.\n\ub0b4\ubd80 \ucfe8\ud0c0\uc784 3\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 40\ud68c."
    effectEight: "\ubc88\uac1c \ub9c8\ubc95 3\ud68c \uc0ac\uc6a9 \uc2dc \ucd5c\ub300 3\uba85\uc758 \ub2e4\ub978 \uc801\uc5d0\uac8c \uac01\uac01 \uae30\ubcf8 \ud53c\ud574 12\uc758 \uc5f0\uc1c4 \uacf5\uaca9.\n\ub0b4\ubd80 \ucfe8\ud0c0\uc784 8\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 20\ud68c."
  - id: gravity
    displayName: "\uc911\ub825\uc758 \uc9c0\ubc30 \uc138\ud2b8"
    effectTwo: "\uc911\ub825 \ub9c8\ubc95 \uc0ac\uac70\ub9ac +10%p."
    effectFour: "\uc911\ub825 \ub9c8\ubc95 \ucd5c\ucd08 \uba85\uc911 \uc9c0\uc810 \uadfc\ucc98\uc758 \uc77c\ubc18 \uc801\uc744 \ucd5c\ub300 1.5m \ub04c\uc5b4\ub2f9\uae41\ub2c8\ub2e4.\n\ub0b4\ubd80 \ucfe8\ud0c0\uc784 6\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 25\ud68c."
    effectEight: "\uc911\ub825 \ub9c8\ubc95 \uc0ac\uc6a9 \uc2dc \ubc18\uacbd 3m\uc758 \uc911\ub825\uc7a5\uc744 3\ucd08\uac04 \uc0dd\uc131\ud569\ub2c8\ub2e4.\n\uc77c\ubc18 \uc801\uc744 \uc911\uc2ec\uc73c\ub85c \ub04c\uc5b4\ub2f9\uae30\uba70 \ucd08\ub2f9 \uae30\ubcf8 \ud53c\ud574 6, \ub0b4\ubd80 \ucfe8\ud0c0\uc784 10\ucd08, \ucd9c\uaca9\ub2f9 \ucd5c\ub300 15\ud68c."
