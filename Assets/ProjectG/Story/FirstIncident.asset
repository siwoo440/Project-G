  m_Script: {fileID: 11500000, guid: e2db505d51eb2d4409a1c9563b0f1a13, type: 3}
  m_Name: FirstIncident
  m_EditorClassIdentifier: Assembly-CSharp::ProjectG.FlightIncidentScript
  Archive: "\uCC9C\uACF5 \uC218\uD638\uC870\uC0AC\uB2E8\uC740 \uD558\uB298\uC12C\uC744
    \uC9C0\uD0B5\uB2C8\uB2E4.\n\uC870\uC0AC\uD300\uC740 \uADE0\uC5F4\uACFC \uB9C8\uBB3C\uC744
    \uC870\uC0AC\uD558\uACE0 \uC218\uD638\uD300\uC740 \uC12C\uACFC \uC8FC\uBBFC\uC744
    \uBCF4\uD638\uD569\uB2C8\uB2E4.\n\uC544\uB9AC\uC544\uC640 \uB9AC\uC548\uC740
    \uD558\uB298\uC12C \uADFC\uCC98\uC5D0\uC11C \uADE0\uC5F4\uC744 \uC870\uC0AC\uD558\uB358
    \uC911\n\uB9C8\uBB3C \uC2B5\uACA9\uC774 \uBC8C\uC5B4\uC9C4 \uD604\uC7A5\uC5D0\uC11C
    \uCC98\uC74C \uB9CC\uB0A9\uB2C8\uB2E4."
  Opening: "\uD558\uB298\uC12C \uADFC\uCC98 \uADE0\uC5F4\uC5D0\uC11C \uB9C8\uBB3C\uC774
    \uB098\uD0C0\uB0AC\uC2B5\uB2C8\uB2E4.\n\uC544\uB9AC\uC544\uC640 \uB9AC\uC548\uC740
    \uC774 \uC2B5\uACA9 \uD604\uC7A5\uC5D0\uC11C \uCC98\uC74C \uB9CC\uB0A9\uB2C8\uB2E4."
  MidBoss: "\uB300\uD615 \uB9C8\uBB3C\uC774 \uD56D\uB85C\uC5D0 \uC9C4\uC785\uD588\uC2B5\uB2C8\uB2E4.\n\uD0C4
    \uC0AC\uC774\uB85C \uC774\uB3D9\uD574 \uC548\uC804\uD55C \uAC70\uB9AC\uB97C \uD655\uBCF4\uD558\uC138\uC694."
  FinalBoss: "\uC678\uACFD \uD56D\uB85C\uC5D0\uC11C \uB610 \uB2E4\uB978 \uB300\uD615
    \uB9C8\uBB3C\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4.\n\uD0C4\uB9C9\uC774
    \uBC14\uB00C\uBA74 \uC548\uC804\uD55C \uACF5\uAC04\uC744 \uB2E4\uC2DC \uCC3E\uC73C\uC138\uC694."
  ClearSummary: "\uC774\uBC88 \uCD9C\uACA9 \xB7 \uC678\uACFD \uD56D\uB85C\uC758 \uC804\uD22C\uB97C
    \uC644\uB8CC\uD588\uC2B5\uB2C8\uB2E4."
  FailureSummary: "\uC774\uBC88 \uCD9C\uACA9 \xB7 \uC678\uACFD \uD56D\uB85C \uC784\uBB34\uB97C
    \uC644\uB8CC\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
